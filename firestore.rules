rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rule: Allow access if the document belongs to the authenticated user
    match /{collection}/{doc} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.user_id == request.auth.uid || request.resource.data.user_id == request.auth.uid
      );
    }
  }
}
